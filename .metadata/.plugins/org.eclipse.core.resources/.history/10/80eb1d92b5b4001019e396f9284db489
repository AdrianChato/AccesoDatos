package Simulacion;

import java.io.FileReader;
import java.io.FileWriter;
import java.io.IOException;
import java.io.PrintWriter;
import java.util.Scanner;

public class LogisticaAmazon {
	
	public static void main(String[] args) throws IOException {
	    LogisticaAmazon la = new LogisticaAmazon();
	    int resultado = la.cuentaPalabraEnFichero(args[0], "Sevilla");
	    System.out.println("Palabras encontradas: " + resultado);
	}

	Scanner in = null;
	public int cuentaPalabraEnFichero(String ruta, String palabra) throws IOException {
		FileReader fr = new FileReader(ruta);
		Scanner in = new Scanner(fr);
		int contador = 0;
		PrintWriter out = null;
		while (in.hasNextLine()) {
			String linea = in.nextLine();
			String[] partes = linea.split(" ");
			for (String p : partes) {
				if (p.equalsIgnoreCase(palabra)) {
					contador++;
					FileWriter fichero;
					fichero = new FileWriter(ruta);
					out = new PrintWriter(fichero);
				}
			}
		}
		if (in != null) {
			in.close();
		}
		return contador;
	}
}

package Simulacion;

import java.io.IOException;

public class PadreLogistica {
	
	private static final String directorioGenerarClasses = "C:\\Users\\alumno\\Desktop\\Spring\\AccesoDatos\\PSP\\target";
	private static final String rutaSourceJava = "C:\\Users\\alumno\\Desktop\\Spring\\AccesoDatos\\PSP\\target\\pedidos.txt";


	public static void main(String[] args) {

		PadreLogistica p = new PadreLogistica();
		
	}
	
	public void compila() {
		String[] comando = { "javac", "-d", directorioGenerarClasses,
				rutaSourceJava };
		ProcessBuilder pb = new ProcessBuilder(comando);
		try {
			pb.redirectErrorStream(true);
			pb.inheritIO();
			Process p1 = pb.start();
			int exit = p1.waitFor();
		} catch (Exception e) {
			logger.error(e.getMessage());
		}
	}

	public void ejecuta(String ficheroTemperaturas, String temp) {
		String[] comando = { "java", "-cp", "target", "Unidad1.boletin2.AnalizadorTemperaturas", ficheroTemperaturas,
				temp };
		ProcessBuilder pb = new ProcessBuilder(comando);
		pb.redirectErrorStream(true);
		pb.inheritIO();
		try {
			pb.start();
			logger.info("Lanzado proceso temp " + temp);
		} catch (IOException e) {
			logger.error("Error : " + e.getMessage());
		}
	}
}

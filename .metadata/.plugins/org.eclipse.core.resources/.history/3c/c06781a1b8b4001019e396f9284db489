package Simulacion;

import java.io.FileReader;
import java.io.FileWriter;
import java.io.IOException;
import java.io.PrintWriter;
import java.util.Scanner;

public class LogisticaAmazon {
	
	public static void main(String[] args) throws IOException {
		LogisticaAmazon la = new LogisticaAmazon();
		int resultado = la.extraePedidosPorProvincia(args[1], args[0]);
		System.out.println(args[0] + " : " + resultado);
	}

	public int extraePedidosPorProvincia(String rutaArchivo, String provincia) throws IOException {
		FileReader fr = new FileReader(rutaArchivo);
		Scanner in = new Scanner(fr);
		PrintWriter out = new PrintWriter(new FileWriter(provincia + ".txt"));
		int contador = 0;

		while (in.hasNextLine()) {
			String linea = in.nextLine();
			if (linea.contains("#" + provincia)) {
				out.println(linea);
				contador++;
			}
		}

		in.close();
		out.close();
		return contador;
	}
}


package Simulacion;

import java.io.IOException;

import org.apache.logging.log4j.LogManager;
import org.apache.logging.log4j.Logger;

public class PadreLogistica {
	
	private static final String directorioGenerarClasses = "C:\\Users\\alumno\\Desktop\\Spring\\AccesoDatos\\PSP\\target";
	private static final String rutaSourceJava = "C:\\Users\\alumno\\Desktop\\Spring\\AccesoDatos\\PSP\\target\\pedidos.txt";

	public static void main(String[] args) {

		PadreLogistica p = new PadreLogistica();
		p.compila();
		p.ejecuta(rutaSourceJava, directorioGenerarClasses);
	}
	
	public void compila() {
		String[] comando = { "javac", "-d", directorioGenerarClasses,
				rutaSourceJava };
		ProcessBuilder pb = new ProcessBuilder(comando);
		try {
			pb.redirectErrorStream(true);
			pb.inheritIO();
			Process p1 = pb.start();
			int exit = p1.waitFor();
		} catch (Exception e) {
			System.out.println(e.getMessage());		}
	}

	public void ejecuta(String ficheroprovincia, String temp) {
		String[] comando = { "java", "-cp", "target", "C:\\\\Users\\\\alumno\\\\Desktop\\\\Spring\\\\AccesoDatos\\\\PSP\\\\target\\\\pedidos.txt", ficheroprovincia,
				temp };
		ProcessBuilder pb = new ProcessBuilder(comando);
		pb.redirectErrorStream(true);
		pb.inheritIO();
		try {
			pb.start();
			System.out.println("Lanzado proceso temp " + temp);;		} 
		catch (IOException e) {
			System.out.println("Error : " + e.getMessage());;
		}
	}
}
